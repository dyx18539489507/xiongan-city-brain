{
  "$defs": {
    "SourceType": {
      "description": "Origin service categories used in every message envelope.",
      "enum": [
        "cloud",
        "edge",
        "vehicle",
        "experiment",
        "report",
        "system",
        "rsu"
      ],
      "title": "SourceType",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Observed delivery outcome from the communication emulator or MQTT layer.",
  "properties": {
    "schema_version": {
      "default": "1.0",
      "pattern": "^\\d+\\.\\d+$",
      "title": "Schema Version",
      "type": "string"
    },
    "message_id": {
      "format": "uuid",
      "title": "Message Id",
      "type": "string"
    },
    "trace_id": {
      "minLength": 1,
      "title": "Trace Id",
      "type": "string"
    },
    "source_id": {
      "minLength": 1,
      "title": "Source Id",
      "type": "string"
    },
    "source_type": {
      "$ref": "#/$defs/SourceType"
    },
    "timestamp_utc": {
      "format": "date-time",
      "title": "Timestamp Utc",
      "type": "string"
    },
    "simulation_time": {
      "minimum": 0,
      "title": "Simulation Time",
      "type": "number"
    },
    "sequence_number": {
      "minimum": 0,
      "title": "Sequence Number",
      "type": "integer"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "expires_at": {
      "format": "date-time",
      "title": "Expires At",
      "type": "string"
    },
    "correlation_id": {
      "minLength": 1,
      "title": "Correlation Id",
      "type": "string"
    },
    "environment": {
      "default": "development",
      "minLength": 1,
      "title": "Environment",
      "type": "string"
    },
    "scenario_id": {
      "minLength": 1,
      "title": "Scenario Id",
      "type": "string"
    },
    "experiment_id": {
      "minLength": 1,
      "title": "Experiment Id",
      "type": "string"
    },
    "channel": {
      "title": "Channel",
      "type": "string"
    },
    "source": {
      "title": "Source",
      "type": "string"
    },
    "destination": {
      "title": "Destination",
      "type": "string"
    },
    "message_type": {
      "title": "Message Type",
      "type": "string"
    },
    "configured_latency_ms": {
      "minimum": 0,
      "title": "Configured Latency Ms",
      "type": "number"
    },
    "actual_latency_ms": {
      "minimum": 0,
      "title": "Actual Latency Ms",
      "type": "number"
    },
    "dropped": {
      "title": "Dropped",
      "type": "boolean"
    },
    "duplicated": {
      "title": "Duplicated",
      "type": "boolean"
    },
    "reordered": {
      "title": "Reordered",
      "type": "boolean"
    },
    "corrupted": {
      "title": "Corrupted",
      "type": "boolean"
    },
    "timeout": {
      "title": "Timeout",
      "type": "boolean"
    },
    "recovery_time": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Recovery Time"
    }
  },
  "required": [
    "trace_id",
    "source_id",
    "source_type",
    "simulation_time",
    "sequence_number",
    "correlation_id",
    "scenario_id",
    "experiment_id",
    "channel",
    "source",
    "destination",
    "message_type",
    "configured_latency_ms",
    "actual_latency_ms",
    "dropped",
    "duplicated",
    "reordered",
    "corrupted",
    "timeout"
  ],
  "title": "CommunicationEvent",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "examples": [
    {
      "schema_version": "1.0",
      "trace_id": "example-trace_id",
      "source_id": "example-source_id",
      "source_type": "cloud",
      "simulation_time": 0.0,
      "sequence_number": 0,
      "correlation_id": "example-correlation_id",
      "environment": "development",
      "scenario_id": "example-scenario_id",
      "experiment_id": "example-experiment_id",
      "channel": "example-channel",
      "source": "example-source",
      "destination": "example-destination",
      "message_type": "example-message_type",
      "configured_latency_ms": 0.0,
      "actual_latency_ms": 0.0,
      "dropped": false,
      "duplicated": false,
      "reordered": false,
      "corrupted": false,
      "timeout": false,
      "recovery_time": null
    }
  ]
}