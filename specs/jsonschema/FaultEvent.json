{
  "$defs": {
    "SourceType": {
      "description": "Origin service categories used in every message envelope.",
      "enum": [
        "cloud",
        "edge",
        "vehicle",
        "experiment",
        "report",
        "system",
        "rsu"
      ],
      "title": "SourceType",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Injected or naturally detected platform fault.",
  "properties": {
    "schema_version": {
      "default": "1.0",
      "pattern": "^\\d+\\.\\d+$",
      "title": "Schema Version",
      "type": "string"
    },
    "message_id": {
      "format": "uuid",
      "title": "Message Id",
      "type": "string"
    },
    "trace_id": {
      "minLength": 1,
      "title": "Trace Id",
      "type": "string"
    },
    "source_id": {
      "minLength": 1,
      "title": "Source Id",
      "type": "string"
    },
    "source_type": {
      "$ref": "#/$defs/SourceType"
    },
    "timestamp_utc": {
      "format": "date-time",
      "title": "Timestamp Utc",
      "type": "string"
    },
    "simulation_time": {
      "minimum": 0,
      "title": "Simulation Time",
      "type": "number"
    },
    "sequence_number": {
      "minimum": 0,
      "title": "Sequence Number",
      "type": "integer"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "expires_at": {
      "format": "date-time",
      "title": "Expires At",
      "type": "string"
    },
    "correlation_id": {
      "minLength": 1,
      "title": "Correlation Id",
      "type": "string"
    },
    "environment": {
      "default": "development",
      "minLength": 1,
      "title": "Environment",
      "type": "string"
    },
    "scenario_id": {
      "minLength": 1,
      "title": "Scenario Id",
      "type": "string"
    },
    "experiment_id": {
      "minLength": 1,
      "title": "Experiment Id",
      "type": "string"
    },
    "fault_type": {
      "title": "Fault Type",
      "type": "string"
    },
    "target": {
      "title": "Target",
      "type": "string"
    },
    "severity": {
      "title": "Severity",
      "type": "string"
    },
    "start_time": {
      "minimum": 0,
      "title": "Start Time",
      "type": "number"
    },
    "duration": {
      "exclusiveMinimum": 0,
      "title": "Duration",
      "type": "number"
    },
    "injected_by": {
      "title": "Injected By",
      "type": "string"
    },
    "recovery_policy": {
      "title": "Recovery Policy",
      "type": "string"
    },
    "recovery_status": {
      "title": "Recovery Status",
      "type": "string"
    }
  },
  "required": [
    "trace_id",
    "source_id",
    "source_type",
    "simulation_time",
    "sequence_number",
    "correlation_id",
    "scenario_id",
    "experiment_id",
    "fault_type",
    "target",
    "severity",
    "start_time",
    "duration",
    "injected_by",
    "recovery_policy",
    "recovery_status"
  ],
  "title": "FaultEvent",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "examples": [
    {
      "schema_version": "1.0",
      "trace_id": "example-trace_id",
      "source_id": "example-source_id",
      "source_type": "cloud",
      "simulation_time": 0.0,
      "sequence_number": 0,
      "correlation_id": "example-correlation_id",
      "environment": "development",
      "scenario_id": "example-scenario_id",
      "experiment_id": "example-experiment_id",
      "fault_type": "example-fault_type",
      "target": "example-target",
      "severity": "example-severity",
      "start_time": 0.0,
      "duration": 1.0,
      "injected_by": "example-injected_by",
      "recovery_policy": "example-recovery_policy",
      "recovery_status": "example-recovery_status"
    }
  ]
}