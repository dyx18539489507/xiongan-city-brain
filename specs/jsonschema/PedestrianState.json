{
  "$defs": {
    "PositionXY": {
      "additionalProperties": false,
      "description": "Cartesian SUMO position in metres.",
      "properties": {
        "x": {
          "title": "X",
          "type": "number"
        },
        "y": {
          "title": "Y",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y"
      ],
      "title": "PositionXY",
      "type": "object"
    },
    "SourceType": {
      "description": "Origin service categories used in every message envelope.",
      "enum": [
        "cloud",
        "edge",
        "vehicle",
        "experiment",
        "report",
        "system",
        "rsu"
      ],
      "title": "SourceType",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "State for one simulated pedestrian with a real walking route.",
  "properties": {
    "schema_version": {
      "default": "1.0",
      "pattern": "^\\d+\\.\\d+$",
      "title": "Schema Version",
      "type": "string"
    },
    "message_id": {
      "format": "uuid",
      "title": "Message Id",
      "type": "string"
    },
    "trace_id": {
      "minLength": 1,
      "title": "Trace Id",
      "type": "string"
    },
    "source_id": {
      "minLength": 1,
      "title": "Source Id",
      "type": "string"
    },
    "source_type": {
      "$ref": "#/$defs/SourceType"
    },
    "timestamp_utc": {
      "format": "date-time",
      "title": "Timestamp Utc",
      "type": "string"
    },
    "simulation_time": {
      "minimum": 0,
      "title": "Simulation Time",
      "type": "number"
    },
    "sequence_number": {
      "minimum": 0,
      "title": "Sequence Number",
      "type": "integer"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "expires_at": {
      "format": "date-time",
      "title": "Expires At",
      "type": "string"
    },
    "correlation_id": {
      "minLength": 1,
      "title": "Correlation Id",
      "type": "string"
    },
    "environment": {
      "default": "development",
      "minLength": 1,
      "title": "Environment",
      "type": "string"
    },
    "scenario_id": {
      "minLength": 1,
      "title": "Scenario Id",
      "type": "string"
    },
    "experiment_id": {
      "minLength": 1,
      "title": "Experiment Id",
      "type": "string"
    },
    "pedestrian_id": {
      "title": "Pedestrian Id",
      "type": "string"
    },
    "pedestrian_type": {
      "title": "Pedestrian Type",
      "type": "string"
    },
    "position_xy": {
      "$ref": "#/$defs/PositionXY"
    },
    "road_id": {
      "title": "Road Id",
      "type": "string"
    },
    "lane_id": {
      "title": "Lane Id",
      "type": "string"
    },
    "speed_m_s": {
      "minimum": 0,
      "title": "Speed M S",
      "type": "number"
    },
    "waiting_time_s": {
      "minimum": 0,
      "title": "Waiting Time S",
      "type": "number"
    },
    "walking_stage_index": {
      "minimum": 0,
      "title": "Walking Stage Index",
      "type": "integer"
    },
    "crossing_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Crossing Id"
    },
    "waiting_area_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Waiting Area Id"
    },
    "signal_state": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Signal State"
    },
    "conflict_risk": {
      "maximum": 1,
      "minimum": 0,
      "title": "Conflict Risk",
      "type": "number"
    }
  },
  "required": [
    "trace_id",
    "source_id",
    "source_type",
    "simulation_time",
    "sequence_number",
    "correlation_id",
    "scenario_id",
    "experiment_id",
    "pedestrian_id",
    "pedestrian_type",
    "position_xy",
    "road_id",
    "lane_id",
    "speed_m_s",
    "waiting_time_s",
    "walking_stage_index",
    "conflict_risk"
  ],
  "title": "PedestrianState",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "examples": [
    {
      "schema_version": "1.0",
      "trace_id": "example-trace_id",
      "source_id": "example-source_id",
      "source_type": "cloud",
      "simulation_time": 0.0,
      "sequence_number": 0,
      "correlation_id": "example-correlation_id",
      "environment": "development",
      "scenario_id": "example-scenario_id",
      "experiment_id": "example-experiment_id",
      "pedestrian_id": "example-pedestrian_id",
      "pedestrian_type": "example-pedestrian_type",
      "position_xy": {
        "x": 0.0,
        "y": 0.0
      },
      "road_id": "example-road_id",
      "lane_id": "example-lane_id",
      "speed_m_s": 0.0,
      "waiting_time_s": 0.0,
      "walking_stage_index": 0,
      "crossing_id": null,
      "waiting_area_id": null,
      "signal_state": null,
      "conflict_risk": 0.0
    }
  ]
}