{
  "$defs": {
    "ExecutionStatus": {
      "description": "Actual outcome of an edge or vehicle command.",
      "enum": [
        "executed",
        "modified",
        "rejected",
        "failed"
      ],
      "title": "ExecutionStatus",
      "type": "string"
    },
    "SourceType": {
      "description": "Origin service categories used in every message envelope.",
      "enum": [
        "cloud",
        "edge",
        "vehicle",
        "experiment",
        "report",
        "system",
        "rsu"
      ],
      "title": "SourceType",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Execution evidence returned to the strategy originator.",
  "properties": {
    "schema_version": {
      "default": "1.0",
      "pattern": "^\\d+\\.\\d+$",
      "title": "Schema Version",
      "type": "string"
    },
    "message_id": {
      "format": "uuid",
      "title": "Message Id",
      "type": "string"
    },
    "trace_id": {
      "minLength": 1,
      "title": "Trace Id",
      "type": "string"
    },
    "source_id": {
      "minLength": 1,
      "title": "Source Id",
      "type": "string"
    },
    "source_type": {
      "$ref": "#/$defs/SourceType"
    },
    "timestamp_utc": {
      "format": "date-time",
      "title": "Timestamp Utc",
      "type": "string"
    },
    "simulation_time": {
      "minimum": 0,
      "title": "Simulation Time",
      "type": "number"
    },
    "sequence_number": {
      "minimum": 0,
      "title": "Sequence Number",
      "type": "integer"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "expires_at": {
      "format": "date-time",
      "title": "Expires At",
      "type": "string"
    },
    "correlation_id": {
      "minLength": 1,
      "title": "Correlation Id",
      "type": "string"
    },
    "environment": {
      "default": "development",
      "minLength": 1,
      "title": "Environment",
      "type": "string"
    },
    "scenario_id": {
      "minLength": 1,
      "title": "Scenario Id",
      "type": "string"
    },
    "experiment_id": {
      "minLength": 1,
      "title": "Experiment Id",
      "type": "string"
    },
    "action_id": {
      "format": "uuid",
      "title": "Action Id",
      "type": "string"
    },
    "strategy_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Strategy Id"
    },
    "intersection_id": {
      "title": "Intersection Id",
      "type": "string"
    },
    "requested_action": {
      "additionalProperties": true,
      "title": "Requested Action",
      "type": "object"
    },
    "executed_action": {
      "additionalProperties": true,
      "title": "Executed Action",
      "type": "object"
    },
    "execution_status": {
      "$ref": "#/$defs/ExecutionStatus"
    },
    "rejection_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Rejection Reason"
    },
    "control_mode": {
      "title": "Control Mode",
      "type": "string"
    },
    "command_latency_ms": {
      "minimum": 0,
      "title": "Command Latency Ms",
      "type": "number"
    },
    "cloud_round_trip_latency_ms": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Cloud Round Trip Latency Ms"
    },
    "actual_start_time": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Actual Start Time"
    },
    "actual_end_time": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Actual End Time"
    },
    "observed_effect": {
      "additionalProperties": {
        "anyOf": [
          {
            "type": "number"
          },
          {
            "type": "string"
          }
        ]
      },
      "title": "Observed Effect",
      "type": "object"
    }
  },
  "required": [
    "trace_id",
    "source_id",
    "source_type",
    "simulation_time",
    "sequence_number",
    "correlation_id",
    "scenario_id",
    "experiment_id",
    "action_id",
    "strategy_id",
    "intersection_id",
    "requested_action",
    "executed_action",
    "execution_status",
    "rejection_reason",
    "control_mode",
    "command_latency_ms",
    "observed_effect"
  ],
  "title": "ExecutionFeedback",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "examples": [
    {
      "schema_version": "1.0",
      "trace_id": "example-trace_id",
      "source_id": "example-source_id",
      "source_type": "cloud",
      "simulation_time": 0.0,
      "sequence_number": 0,
      "correlation_id": "example-correlation_id",
      "environment": "development",
      "scenario_id": "example-scenario_id",
      "experiment_id": "example-experiment_id",
      "action_id": "00000000-0000-4000-8000-000000000001",
      "strategy_id": "00000000-0000-4000-8000-000000000001",
      "intersection_id": "example-intersection_id",
      "requested_action": {},
      "executed_action": {},
      "execution_status": "executed",
      "rejection_reason": "example-rejection_reason",
      "control_mode": "example-control_mode",
      "command_latency_ms": 0.0,
      "cloud_round_trip_latency_ms": null,
      "actual_start_time": null,
      "actual_end_time": null,
      "observed_effect": {}
    }
  ]
}