{
  "$defs": {
    "SourceType": {
      "description": "Origin service categories used in every message envelope.",
      "enum": [
        "cloud",
        "edge",
        "vehicle",
        "experiment",
        "report",
        "system",
        "rsu"
      ],
      "title": "SourceType",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Vehicle-agent validated speed command consumed by the SUMO owner.",
  "properties": {
    "schema_version": {
      "default": "1.0",
      "pattern": "^\\d+\\.\\d+$",
      "title": "Schema Version",
      "type": "string"
    },
    "message_id": {
      "format": "uuid",
      "title": "Message Id",
      "type": "string"
    },
    "trace_id": {
      "minLength": 1,
      "title": "Trace Id",
      "type": "string"
    },
    "source_id": {
      "minLength": 1,
      "title": "Source Id",
      "type": "string"
    },
    "source_type": {
      "$ref": "#/$defs/SourceType"
    },
    "timestamp_utc": {
      "format": "date-time",
      "title": "Timestamp Utc",
      "type": "string"
    },
    "simulation_time": {
      "minimum": 0,
      "title": "Simulation Time",
      "type": "number"
    },
    "sequence_number": {
      "minimum": 0,
      "title": "Sequence Number",
      "type": "integer"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "expires_at": {
      "format": "date-time",
      "title": "Expires At",
      "type": "string"
    },
    "correlation_id": {
      "minLength": 1,
      "title": "Correlation Id",
      "type": "string"
    },
    "environment": {
      "default": "development",
      "minLength": 1,
      "title": "Environment",
      "type": "string"
    },
    "scenario_id": {
      "minLength": 1,
      "title": "Scenario Id",
      "type": "string"
    },
    "experiment_id": {
      "minLength": 1,
      "title": "Experiment Id",
      "type": "string"
    },
    "vehicle_id": {
      "title": "Vehicle Id",
      "type": "string"
    },
    "requested_speed_m_s": {
      "minimum": 0,
      "title": "Requested Speed M S",
      "type": "number"
    },
    "applied_speed_m_s": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Applied Speed M S"
    },
    "executed": {
      "title": "Executed",
      "type": "boolean"
    },
    "validation_status": {
      "title": "Validation Status",
      "type": "string"
    },
    "validation_reasons": {
      "items": {
        "type": "string"
      },
      "title": "Validation Reasons",
      "type": "array"
    }
  },
  "required": [
    "trace_id",
    "source_id",
    "source_type",
    "simulation_time",
    "sequence_number",
    "correlation_id",
    "scenario_id",
    "experiment_id",
    "vehicle_id",
    "requested_speed_m_s",
    "executed",
    "validation_status"
  ],
  "title": "VehicleGuidanceCommand",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "examples": [
    {
      "schema_version": "1.0",
      "trace_id": "example-trace_id",
      "source_id": "example-source_id",
      "source_type": "cloud",
      "simulation_time": 0.0,
      "sequence_number": 0,
      "correlation_id": "example-correlation_id",
      "environment": "development",
      "scenario_id": "example-scenario_id",
      "experiment_id": "example-experiment_id",
      "vehicle_id": "example-vehicle_id",
      "requested_speed_m_s": 0.0,
      "applied_speed_m_s": null,
      "executed": false,
      "validation_status": "example-validation_status"
    }
  ]
}