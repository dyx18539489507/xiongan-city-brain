{
  "$defs": {
    "ActionType": {
      "description": "Supported edge control action verbs.",
      "enum": [
        "hold_phase",
        "extend_green",
        "terminate_phase",
        "request_next_phase",
        "change_cycle_target",
        "apply_speed_guidance",
        "fallback_fixed_time"
      ],
      "title": "ActionType",
      "type": "string"
    },
    "SourceType": {
      "description": "Origin service categories used in every message envelope.",
      "enum": [
        "cloud",
        "edge",
        "vehicle",
        "experiment",
        "report",
        "system",
        "rsu"
      ],
      "title": "SourceType",
      "type": "string"
    },
    "ValidationStatus": {
      "description": "Safety-kernel outcome attached to an edge action.",
      "enum": [
        "pending",
        "accepted",
        "modified",
        "rejected"
      ],
      "title": "ValidationStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Candidate or validated local control action.",
  "properties": {
    "schema_version": {
      "default": "1.0",
      "pattern": "^\\d+\\.\\d+$",
      "title": "Schema Version",
      "type": "string"
    },
    "message_id": {
      "format": "uuid",
      "title": "Message Id",
      "type": "string"
    },
    "trace_id": {
      "minLength": 1,
      "title": "Trace Id",
      "type": "string"
    },
    "source_id": {
      "minLength": 1,
      "title": "Source Id",
      "type": "string"
    },
    "source_type": {
      "$ref": "#/$defs/SourceType"
    },
    "timestamp_utc": {
      "format": "date-time",
      "title": "Timestamp Utc",
      "type": "string"
    },
    "simulation_time": {
      "minimum": 0,
      "title": "Simulation Time",
      "type": "number"
    },
    "sequence_number": {
      "minimum": 0,
      "title": "Sequence Number",
      "type": "integer"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "expires_at": {
      "format": "date-time",
      "title": "Expires At",
      "type": "string"
    },
    "correlation_id": {
      "minLength": 1,
      "title": "Correlation Id",
      "type": "string"
    },
    "environment": {
      "default": "development",
      "minLength": 1,
      "title": "Environment",
      "type": "string"
    },
    "scenario_id": {
      "minLength": 1,
      "title": "Scenario Id",
      "type": "string"
    },
    "experiment_id": {
      "minLength": 1,
      "title": "Experiment Id",
      "type": "string"
    },
    "action_id": {
      "format": "uuid",
      "title": "Action Id",
      "type": "string"
    },
    "intersection_id": {
      "title": "Intersection Id",
      "type": "string"
    },
    "requested_phase_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Requested Phase Id"
    },
    "action_type": {
      "$ref": "#/$defs/ActionType"
    },
    "requested_duration": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Requested Duration"
    },
    "source_strategy_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Source Strategy Id"
    },
    "validation_status": {
      "$ref": "#/$defs/ValidationStatus",
      "default": "pending"
    },
    "rejection_reasons": {
      "items": {
        "type": "string"
      },
      "title": "Rejection Reasons",
      "type": "array"
    },
    "applied_at": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Applied At"
    },
    "expected_effect": {
      "additionalProperties": {
        "anyOf": [
          {
            "type": "number"
          },
          {
            "type": "string"
          }
        ]
      },
      "title": "Expected Effect",
      "type": "object"
    },
    "recommended_speed_m_s": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Recommended Speed M S"
    }
  },
  "required": [
    "trace_id",
    "source_id",
    "source_type",
    "simulation_time",
    "sequence_number",
    "correlation_id",
    "scenario_id",
    "experiment_id",
    "intersection_id",
    "requested_phase_id",
    "action_type",
    "source_strategy_id",
    "expected_effect"
  ],
  "title": "EdgeControlAction",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "examples": [
    {
      "schema_version": "1.0",
      "trace_id": "example-trace_id",
      "source_id": "example-source_id",
      "source_type": "cloud",
      "simulation_time": 0.0,
      "sequence_number": 0,
      "correlation_id": "example-correlation_id",
      "environment": "development",
      "scenario_id": "example-scenario_id",
      "experiment_id": "example-experiment_id",
      "intersection_id": "example-intersection_id",
      "requested_phase_id": "example-requested_phase_id",
      "action_type": "hold_phase",
      "requested_duration": null,
      "source_strategy_id": "00000000-0000-4000-8000-000000000001",
      "validation_status": "pending",
      "applied_at": null,
      "expected_effect": {},
      "recommended_speed_m_s": null
    }
  ]
}