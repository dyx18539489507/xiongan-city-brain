<?xml version='1.0' encoding='utf-8'?>
<configuration>
    <input>
        <net-file value="demo_6_offpeak.net.xml" />
        <route-files value="demo_6_offpeak.rou.xml" />
        <gui-settings-file value="simple-shapes.view.xml" />
    </input>
    <time>
        <begin value="0" />
        <end value="9000" />
        <step-length value="1.0" />
    </time>
    <processing>
        <time-to-teleport value="-1" />
        <collision.action value="warn" />
    </processing>
    <report>
        <no-step-log value="true" />
        <duration-log.statistics value="true" />
    </report>
    <output>
        <summary-output value="outputs/offpeak/summary.xml" />
        <tripinfo-output value="outputs/offpeak/tripinfo.xml" />
        <statistic-output value="outputs/offpeak/statistics.xml" />
        <vehroute-output value="outputs/offpeak/vehroute.xml" />
    </output>
    <random_number>
        <seed value="6" />
    </random_number>
    <gui_only>
        <delay value="300" />
    </gui_only>
</configuration>